# Solo desarrollo local. Copia este archivo como .env y cambia la contraseña.
POSTGRES_DB=eso_me_sirve
POSTGRES_USER=ems_local
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ems_local:change-me-local-only@127.0.0.1:5432/eso_me_sirve

# Identidad. Genera un secreto distinto con alta entropía para cada entorno real.
# Este valor es solo una muestra local y no debe reutilizarse fuera de desarrollo.
BETTER_AUTH_SECRET=local-only-change-this-identity-secret-32-chars
BETTER_AUTH_URL=http://localhost:3000
APP_ENV=development
EMAIL_DELIVERY_MODE=database
PHOTO_STORAGE_ROOT=.data/listing-photos

# Contacto privado. Ejecuta npm run dev:init-contact-key; no imprime ni versiona la clave.
PRIVATE_CONTACT_ACTIVE_KEY_VERSION=1
PRIVATE_CONTACT_KEY_V1_FILE=.data/secrets/private-contact-key-v1

# Solo para el ejemplo productivo de Caddy; no despliega recursos.
APP_DOMAIN=ems.example.invalid

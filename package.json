{
  "name": "eso-me-sirve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base tecnica de la PWA Eso Me Sirve",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env scripts/run-e2e.mjs",
    "test:docker-contact": "node --env-file-if-exists=.env scripts/verify-docker-private-contact.mjs",
    "dev:init-contact-key": "node --env-file-if-exists=.env scripts/init-private-contact-key.mjs",
    "dev:seed-users": "node --env-file-if-exists=.env --experimental-strip-types scripts/dev-seed-users.ts",
    "mailbox:latest": "node --env-file-if-exists=.env scripts/read-dev-mailbox.mjs",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m db/migrations --migration-file-language sql up",
    "db:migrate:down": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m db/migrations --migration-file-language sql down",
    "reservations:expire": "node --env-file-if-exists=.env scripts/expire-reservations.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "node-pg-migrate": "9.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
